# Required. Get one free at https://aistudio.google.com/apikey
# Accepts several keys separated by commas. Each key is a separate Google
# project with its own allowance, so listing a spare keeps the site answering
# after the first one is spent.
GEMINI_API_KEY=your_key_here

# Optional. Accepts several models separated by commas, tried in order.
# Google meters the free tier per model, so each extra name is another
# allowance. The first is preferred; the rest are only used if it is
# unavailable. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# Optional. Defaults to 3000.
PORT=3000
